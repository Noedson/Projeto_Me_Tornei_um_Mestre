{
  "latex-workshop.linting.chktex.enabled": false,
  "latex-workshop.linting.lacheck.enabled": false,
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoClean.run": "always",
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.message.error.show": false,
  "latex-workshop.message.warning.show": false,
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex (limpar temporarios)",
      "tools": [
        "pdflatex",
        "limpar_temp"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOCFILE%"
      ]
    },
    {
      "name": "limpar_temp",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Remove-Item -Path '%DIR%\\*' -Include *.aux,*.bbl,*.blg,*.idx,*.ind,*.lof,*.lot,*.out,*.toc,*.acn,*.acr,*.alg,*.glg,*.glo,*.gls,*.fls,*.log,*.fdb_latexmk,*.snm,*.nav,*.loq,*.synctex.gz,*.brf -Force -ErrorAction SilentlyContinue"
      ]
    }
  ],
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.wordcount.enabled": false,
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.fls",
    "*.log",
    "*.fdb_latexmk",
    "*.snm",
    "*.nav",
    "*.loq",
    "*.brf",
    "*.synctex.gz"
  ]
}
